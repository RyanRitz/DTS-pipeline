# Normalize line endings. Without this, Windows tools rewrite files to CRLF
# and git reports the whole repo as modified with no real content change.
* text=auto eol=lf

# Batch files must keep CRLF -- labels and goto can misbehave with LF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Never diff or normalize these.
*.pdf  binary
*.xlsx binary
*.xls  binary
*.zip  binary
*.png  binary
*.docx binary
*.sas7bdat binary
